# ---------------------------------------------------------------
# Local development (.env.local). On Vercel these come from the
# Supabase integration + Project Settings → Environment Variables.
# ---------------------------------------------------------------

# Database used by the app. Local default if unset:
# postgresql://naresh@localhost:5432/textile_db
DATABASE_URL=

# Direct (non-pooled) connection for migrations. Optional locally.
# On Vercel + Supabase the integration provides POSTGRES_URL_NON_POOLING.
MIGRATION_DATABASE_URL=

# Photo storage (Supabase Storage). If unset locally, photos go to public/uploads/YYYY/MM/DD.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# PHOTO_BUCKET=capture-photos

# OCR — the default way photos are read (cheapest). Google Cloud → enable "Cloud Vision API" → API key.
GOOGLE_VISION_API_KEY=
# Below this mean OCR word confidence the photo goes to the AI instead (0–1, default 0.75).
# OCR_MIN_CONFIDENCE=0.75

# AI (Gemini): fallback for photos OCR can't read, and chat routing / firm-knowledge answers.
GEMINI_API_KEY=
# Model tiers. GEMINI_MODEL sets both; the tier-specific ones override it. Default gemini-3.5-flash.
GEMINI_MODEL=
# GEMINI_MODEL_LOW=     # cheap/fast: chat intent, reading OCR text, knowledge answers
# GEMINI_MODEL_HIGH=    # strongest: reading a photo directly

# Prices for the usage/cost log (USD). Defaults are estimates — set them from Google's price list.
# LLM_PRICE_LOW_IN=0.10      # per 1M input tokens
# LLM_PRICE_LOW_OUT=0.40     # per 1M output tokens
# LLM_PRICE_HIGH_IN=0.30
# LLM_PRICE_HIGH_OUT=2.50
# OCR_PRICE_PER_IMAGE=0.0015

# Developer-only AI usage/cost log: GET /api/dev/usage with header x-dev-token. At least 16 characters.
# Unset = the endpoint doesn't exist.
DEV_ACCESS_TOKEN=

# Vercel Cron → /api/agents/run sends this as a Bearer token (set it in Vercel; not needed locally).
CRON_SECRET=

# Optional switches
# SKIP_DB_MIGRATIONS=1   # don't auto-apply migrations when the local server starts
# ALLOW_MOCK_AI=1        # allow fake AI reads outside development (demos only)
# ALLOW_DEMO_SEED=1      # let `npm run db:seed-demo` write to a non-local (test) database
