# ---------------------------------------------------------------
# Local development (.env.local). On Vercel these come from the
# Supabase integration + Project Settings → Environment Variables.
# ---------------------------------------------------------------

# Database used by the app. Local default if unset:
# postgresql://naresh@localhost:5432/textile_db
DATABASE_URL=

# Direct (non-pooled) connection for migrations. Optional locally.
# On Vercel + Supabase the integration provides POSTGRES_URL_NON_POOLING.
MIGRATION_DATABASE_URL=

# Photo storage (Supabase Storage). If unset locally, photos go to public/uploads.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# PHOTO_BUCKET=capture-photos

# AI photo reading + chat. Required in production (without it, photo reading is refused).
GEMINI_API_KEY=

# Optional switches
# SKIP_DB_MIGRATIONS=1   # don't auto-apply migrations when the local server starts
# ALLOW_MOCK_AI=1        # allow fake AI reads outside development (demos only)
