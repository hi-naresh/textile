{
  "name": "textile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.js && next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-route-auth.js",
    "lint:auth": "node scripts/check-route-auth.js",
    "dev:create": "node scripts/create-developer.js",
    "db:migrate": "node scripts/migrate.js",
    "db:init": "node scripts/db-init.js && node scripts/migrate.js",
    "db:seed-demo": "node scripts/seed-demo.js && node scripts/seed-demo-logins.js",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "tunnel": "npx -y cloudflared tunnel --url http://localhost:3000",
    "db:seed-showcase": "tsx scripts/seed-showcase.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
